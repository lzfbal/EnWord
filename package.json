{
  "name": "enword",
  "version": "0.00.01",
  "description": "English word trainer desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "electron",
    "vocabulary",
    "sqlite"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.enword.desktop",
    "productName": "EnWord",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "src/main/**/*.js",
      "src/renderer/**/*.js",
      "preload.js",
      "index.html",
      "style.css",
      "app.runtime.js",
      "app.js",
      "words.json",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis"
    }
  }
}
